# Copia a .env (no se sube a git). Nunca subas el token real.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=   # solo A-Z a-z 0-9 _ -  (ej: openssl rand -hex 32)
BOT_MODE=webhook           # webhook | off  (para polling local usa: npm run bot)
PUBLIC_URL=                # https://bundle-sniffer.onrender.com
RPC_URL=                   # https://mainnet.helius-rpc.com/?api-key=XXXX (vacío = RPC público)
